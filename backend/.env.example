# PostgreSQL + pgvector (Supabase / Neon / local)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/abelink

# Google Cloud Vertex AI
GOOGLE_CLOUD_PROJECT=751082713943
GOOGLE_CLOUD_LOCATION=global
GEMMA_MODEL=google/gemma-4-26b-a4b-it-maas
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768

# Web enrichment (Free-first DDG + optional Tavily fallback & local SQLite cache)
TAVILY_API_KEY=your_tavily_api_key
PREFER_FREE_SEARCH=true
ENRICHMENT_CACHE_PATH=~/.cache/abelink/enrichment_cache.sqlite

# Auth & CORS
AUTH_SECRET=change-me-in-production
LINKCS_IMPORT_TOKEN=
CORS_ORIGINS=http://localhost:5173,https://abelink.app,https://dev.abelink.app
ALLOW_DEMO_AUTH=true
DEMO_MODE=false
# Optionnel : charger directement un export LinkCS (.json ou .csv) en mode démo / mémoire
# LINKCS_DATA_PATH=/path/to/linkcs_amis.json
PUBLIC_API_URL=http://localhost:8000
