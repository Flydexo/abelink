# Public template only. Never put real secrets in this tracked file.
# Save actual values in Dokploy: abelink -> dev -> existing web Compose -> env.
# That Compose uses docker-compose.dev.yml and deploys web + backend + database.

# Generate 32 random bytes as hex privately if absent; never rotate implicitly.
POSTGRES_PASSWORD=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMMA_MODEL=
EMBEDDING_MODEL=
# Complete compact Google credential JSON, single-quoted in the dotenv document.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Generate privately if absent; preserve any existing dev signing secret.
AUTH_SECRET=
# Dedicated administration key for the LinkCS upload page; generate privately.
LINKCS_IMPORT_TOKEN=
TAVILY_API_KEY=
PREFER_FREE_SEARCH=true
# Optional photo fallback only; leave empty for the initial deployment.
LINKEDIN_LI_AT=
